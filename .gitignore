# Dependencies / build output
node_modules/
.next/
out/
*.tsbuildinfo

# Jac persisted graph (regenerated on every run)
.jac/

# Python
# NOTE: do NOT re-add the setuptools boilerplate (lib/, build/, dist/, var/,
# parts/, wheels/ …). Those patterns are unanchored, so `lib/` matched
# web-ui/src/lib and web-next/lib and hid the entire frontend data layer from
# git. This project has no Python packaging — __pycache__ and the venv are all
# that actually need excluding.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment / secrets
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Cache
.cache/
